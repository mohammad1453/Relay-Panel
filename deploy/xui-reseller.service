[Unit]
Description=Independent 3X-UI reseller console
After=network.target

[Service]
Type=simple
User=xui-reseller
Group=xui-reseller
WorkingDirectory=/opt/3xui-reseller
ExecStart=/opt/3xui-reseller/.venv/bin/python -m reseller.manage serve --env /etc/3xui-reseller/app.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/3xui-reseller
ReadOnlyPaths=/etc/3xui-reseller
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

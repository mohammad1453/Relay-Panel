# Load with: python -m reseller.manage serve --env /path/to/app.env
APP_ENV=production
APP_ORIGIN=https://reseller.example.com
APP_BASE_PATH=
# Values: production, development (loopback only), public-http (explicit plaintext IP mode).
APP_DB=/var/lib/3xui-reseller/app.db
# Mandatory in production: known original SQLite paths, comma-separated; use 'external' for PostgreSQL.
XUI_DATABASE_PATHS=/etc/x-ui/x-ui.db
APP_TIMEZONE=Asia/Tehran
APP_PORT=8095
SESSION_SECONDS=43200
SESSION_IDLE_SECONDS=1800
SYNC_SECONDS=120
# Include the actual panel web base path. HTTP allowed only on loopback.
XUI_URL=http://127.0.0.1:2053/your-web-path/
# Admin-scoped server-side token OR panel username/password (never reseller API keys).
XUI_TOKEN=
XUI_USERNAME=
XUI_PASSWORD=
XUI_CONNECT_TIMEOUT=5
XUI_TIMEOUT=20
# Optional trusted public host used by the panel's link generator.
XUI_LINK_HOST=
# Optional public subscription base URL (HTTPS). The customer's subId is appended,
# e.g. https://sub.example.com/i/ -> https://sub.example.com/i/<subId>.
# Leave blank to hide the subscription link.
XUI_SUB_URL=
# Bootstrap through the interactive command; these optional variables never reset existing admin.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
